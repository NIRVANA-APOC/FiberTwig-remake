<o c="TLabTabForm">
<p n="ParentName">WHelp</p>
<p n="Name">TAboutWHelp</p>
<p n="Tag">153</p>
<p n="Left">15</p>
<p n="Top">15</p>
<p n="Width">495</p>
<p n="Height">470</p>
<p n="OriginLeft">65</p>
