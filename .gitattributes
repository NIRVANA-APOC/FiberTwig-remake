# Normalize line endings: LF in the repository, platform-appropriate on checkout.
* text=auto

# Batch files must be CRLF for cmd.exe, shell scripts must stay LF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf

# Binary assets (detected automatically, listed for clarity).
*.png binary
*.PNG binary
*.pNg binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ogg binary
*.wav binary
*.mo3 binary
*.zxc binary
*.dat binary
*.exe binary
*.dll binary
*.sav binary
*.zip binary
*.tpz binary
